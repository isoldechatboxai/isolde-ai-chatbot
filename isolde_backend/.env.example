# Rename this file to .env and fill in real values. NEVER commit the real .env.

# --- AI provider bootstrap (configure at least one in production) ---
# Get a Gemini key at https://aistudio.google.com/apikey. Other provider
# credentials may be supplied here or rotated later through the encrypted
# versioned admin provider-settings API. Never commit a real .env file.
GEMINI_API_KEY=
# "gemini-flash-latest" auto-points at Google's current recommended fast model.
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- Flask ---
APP_VERSION=
FLASK_SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_TESTING=false
SQLALCHEMY_ECHO=false
TRUST_PROXY_HOPS=0
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SAMESITE=Lax
LOG_TO_FILE=true
LOG_DIR=logs
# Test-token exposure is honored only while FLASK_TESTING=true; keep false
# outside isolated test runs.
EXPOSE_TEST_AUTH_TOKENS=false

# --- Explicit demo/staging Super Admin bootstrap (disabled by default) ---
# Allowed only with FLASK_ENV=demo or staging. These values must come from a
# secret manager or deployment environment, never source control. Markers must
# identify an isolated database and private S3 bucket; production rejects this.
DEMO_ADMIN_BOOTSTRAP_ENABLED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_DATABASE_MARKER=
DEMO_STORAGE_MARKER=

# --- JWT ---
JWT_SECRET_KEY=change_this_to_a_different_long_random_string_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MIN=60
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=15

# --- OAuth/OIDC (leave blank to disable a provider) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Example when enabled: https://your-public-domain.example/api/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Example when enabled: https://your-public-domain.example/api/oauth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value; encode newlines as \n when supplied on one environment line.
APPLE_PRIVATE_KEY=
# Example when enabled: https://your-public-domain.example/api/oauth/apple/callback
APPLE_OAUTH_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
# Example when enabled: https://your-public-domain.example/api/oauth/microsoft/callback
MICROSOFT_OAUTH_REDIRECT_URI=
OAUTH_HTTP_TIMEOUT_SECONDS=10
PROVIDER_HTTP_TIMEOUT_SECONDS=60

# --- Database (SQLite for dev, swap for a Postgres URL in production) ---
DATABASE_URL=sqlite:///isolde.db
# PostgreSQL pool health settings. Production uses pre-ping automatically;
# these tune its bounded worker pool without changing SSL settings.
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

# --- Uploads ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=15
VECTOR_STORE_DIR=vector_store
STORAGE_BACKEND=local
# Production requires private S3-compatible object storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments (leave PAYMENT_PROVIDER blank to disable checkout) ---
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
PAYMENT_SUCCESS_URL=http://127.0.0.1:5000/billing.html?checkout=success
PAYMENT_CANCEL_URL=http://127.0.0.1:5000/billing.html?checkout=cancelled
BILLING_RATE_LIMIT=10 per minute
CREDIT_TOKENS_PER_UNIT=1000

# Media generation is disabled until an implemented provider is selected.
IMAGE_PROVIDER=
VIDEO_PROVIDER=

# --- CORS ---
# Only matters if you serve the frontend separately from the backend
# (e.g. a Live Server extension on port 5500). If you just run
# `python run.py` and open http://127.0.0.1:5000/, the frontend is
# served BY this same Flask app, so it's same-origin and CORS doesn't
# apply at all. Comma-separated list of allowed origins, or "*" for dev.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Shared production rate-limit storage ---
# Required in production; memory:// is development-only.
# REDIS_URL is not read by the application. Supply the two canonical URLs
# below (they may point at different Redis databases on the same service).
RATELIMIT_STORAGE_URI=memory://
CANCELLATION_REDIS_URL=
CANCELLATION_TTL_SECONDS=900
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# RAG chunks and embeddings are transactional database records. Production
# requires database; migrate an old index with: flask rag-import-json vector_store/index.json
RAG_STORAGE_BACKEND=database
AUTH_RATE_LIMIT=10 per minute
API_KEY_RATE_LIMIT=5 per minute
SAAS_API_KEY_RATE_LIMIT=10 per minute
CHAT_RATE_LIMIT=20 per minute
UPLOAD_RATE_LIMIT=10 per minute
OAUTH_RATE_LIMIT=20 per minute

# --- Optional bounded web research ---
TAVILY_API_KEY=
RESEARCH_HTTP_TIMEOUT_SECONDS=8
RESEARCH_FETCH_MAX_SOURCES=2
RESEARCH_FETCH_MAX_BYTES=200000
RESEARCH_FETCH_MAX_CHARS=12000
RESEARCH_CONTEXT_MAX_CHARS=24000
CHAT_MAX_PROMPT_CHARS=12000
RESEARCH_QUERY_MAX_CHARS=2000
RAG_QUERY_MAX_CHARS=4000

# --- Transactional email (required for verification/reset delivery) ---
PUBLIC_APP_URL=http://127.0.0.1:5000
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_TIMEOUT_SECONDS=10
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# --- Opt-in deployed external E2E harness (test/test_external_e2e.py) ---
# Supply these only in the shell/CI secret store that runs the smoke test.
# RUN_EXTERNAL_E2E=1
# ISOLDE_E2E_BASE_URL=https://your-deployment.example
# ISOLDE_E2E_EMAIL=
# ISOLDE_E2E_PASSWORD=
# ISOLDE_E2E_TIMEOUT_SECONDS=30
# ISOLDE_E2E_CHAT_PROMPT=Reply briefly with READY.
# ISOLDE_E2E_STREAM_PROMPT=Reply briefly with STREAM READY.
# ISOLDE_E2E_RESEARCH_QUERY=What is the latest stable Python release?
# ISOLDE_E2E_RAG_QUERY=production readiness
# ISOLDE_E2E_UPLOAD_FILE=
