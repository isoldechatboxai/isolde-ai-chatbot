# Rename this file to .env and fill in real values. NEVER commit the real .env.

# --- Gemini API ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
# "gemini-flash-latest" auto-points at Google's current recommended fast model.
GEMINI_MODEL=gemini-flash-latest

# --- Flask ---
FLASK_SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
FLASK_ENV=development
FLASK_DEBUG=True

# --- JWT ---
JWT_SECRET_KEY=change_this_to_a_different_long_random_string_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MIN=60
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=15

# --- OAuth/OIDC (leave blank to disable a provider) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/github/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM value; encode newlines as \n when supplied on one environment line.
APPLE_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=https://your-public-https-domain.example/api/oauth/apple/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/microsoft/callback

# --- Database (SQLite for dev, swap for a Postgres URL in production) ---
DATABASE_URL=sqlite:///isolde.db

# --- Uploads ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=15

# --- CORS ---
# Only matters if you serve the frontend separately from the backend
# (e.g. a Live Server extension on port 5500). If you just run
# `python run.py` and open http://127.0.0.1:5000/, the frontend is
# served BY this same Flask app, so it's same-origin and CORS doesn't
# apply at all. Comma-separated list of allowed origins, or "*" for dev.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Shared production rate-limit storage ---
# Required in production; memory:// is development-only.
RATELIMIT_STORAGE_URI=memory://

# --- Transactional email (required for verification/reset delivery) ---
PUBLIC_APP_URL=http://127.0.0.1:5000
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
